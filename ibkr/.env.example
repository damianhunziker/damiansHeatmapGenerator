# Interactive Brokers credentials.
# The SAME login works for paper mode; TRADING_MODE selects the paper account.
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# paper | live | both
TRADING_MODE=paper

# yes = API can read but never place orders. Set to yes for live accounts.
READ_ONLY_API=no

# Accept incoming API connections without a dialog.
TWS_ACCEPT_INCOMING=accept

# 2FA handling. Approve the IBKR Mobile push after `docker compose up`.
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWOFA_EXIT_INTERVAL=180

TIME_ZONE=Europe/Zurich
JAVA_HEAP_SIZE=1024

# Optional local VNC console (needed to click through 2FA or inspect the UI).
# Leave empty to disable. Then also uncomment the 5900 port in docker-compose.yml.
VNC_SERVER_PASSWORD=
