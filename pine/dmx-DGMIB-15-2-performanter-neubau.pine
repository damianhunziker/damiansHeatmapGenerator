var fibo_ratios = array.new_float(0)
var colors = array.new_color(2)
if barstate.isfirst
    array.unshift(colors, upcol)
    array.unshift(colors, dncol)
    array.push(fibo_ratios, 0.236)
    array.push(fibo_ratios, 0.382)
    array.push(fibo_ratios, 0.618)
    array.push(fibo_ratios, 0.786)

get_channel(src_lr2, len_lr) =>
    mid = math.sum(src_lr2, len_lr) / len_lr
    slope = ta.linreg(src_lr2, len_lr, 0) - ta.linreg(src_lr2, len_lr, 1)
    intercept = mid - slope * math.floor(len_lr / 2) + (1 - len_lr % 2) / 2 * slope
    endy = intercept + slope * (len_lr - 1)
    dev = 0.0
    for x = 0 to len_lr - 1 by 1
        dev += math.pow(src_lr2[x] - (slope * (len_lr - x) + intercept), 2)
        dev
    dev := math.sqrt(dev / len_lr)
    [intercept, endy, dev, slope]

[y1_, y2_, dev, slope] = get_channel(src_lr2, len_lr)

[y1__slow, y2__slow, dev_slow, slope_slow] = get_channel(src_lr2_slow, len_lr_slow)

[y1__veryslow, y2__veryslow, dev_veryslow, slope_veryslow] = get_channel(src_lr2_veryslow, len_lr_veryslow)

[y1__slowest, y2__slowest, dev_slowest, slope_slowest] = get_channel(src_lr2_slowest, len_lr_slowest)

outofchannel = slope > 0 and close < y2_ - dev * devlen_lr ? 0 : slope < 0 and close > y2_ + dev * devlen_lr ? 2 : -1

linedelete = 0

var reglines = array.new_line(3)
var fibolines = array.new_line(4)
for x = 0 to 2 by 1
    if not showbroken or outofchannel != x or nz(outofchannel[1], -1) != -1
        line.delete(array.get(reglines, x))
    else
        linedelete := 1
        line.set_color(array.get(reglines, x), color=brokencol)
        line.set_width(array.get(reglines, x), width=2)
        line.set_style(array.get(reglines, x), style=line.style_dotted)
        line.set_extend(array.get(reglines, x), extend=extend.none)

    array.set(reglines, x, line.new(x1=bar_index - (len_lr - 1), y1=y1_ + dev * devlen_lr * (x - 1), x2=bar_index, y2=y2_ + dev * devlen_lr * (x - 1), color=array.get(colors, math.round(math.max(math.sign(slope), 0))), style=x % 2 == 1 ? line.style_solid : line.style_dashed, width=widt, extend=extendit ? extend.right : extend.none))
if showfibo
    for x = 0 to 3 by 1
        line.delete(array.get(fibolines, x))
        array.set(fibolines, x, line.new(x1=bar_index - (len_lr - 1), y1=y1_ - dev * devlen_lr + dev * devlen_lr * 2 * array.get(fibo_ratios, x), x2=bar_index, y2=y2_ - dev * devlen_lr + dev * devlen_lr * 2 * array.get(fibo_ratios, x), color=array.get(colors, math.round(math.max(math.sign(slope), 0))), style=line.style_dotted, width=widt, extend=extendit ? extend.right : extend.none))

var label sidelab = label.new(x=bar_index - (len_lr - 1), y=y1_, text='S', size=size.large)
txt = slope > 0 ? slope > slope[1] ? '⇑' : '⇗' : slope < 0 ? slope < slope[1] ? '⇓' : '⇘' : '⇒'
stl = slope > 0 ? slope > slope[1] ? label.style_label_up : label.style_label_upper_right : slope < 0 ? slope < slope[1] ? label.style_label_down : label.style_label_lower_right : label.style_label_right
label.set_style(sidelab, stl)
label.set_text(sidelab, txt)
label.set_x(sidelab, bar_index - (len_lr - 1))
label.set_y(sidelab, slope > 0 ? y1_ - dev * devlen_lr : slope < 0 ? y1_ + dev * devlen_lr : y1_)
label.set_color(sidelab, slope > 0 ? upcol : slope < 0 ? dncol : color.blue)

// direction
trendisup = math.sign(slope) != math.sign(slope[1]) and slope > 0
trendisdown = math.sign(slope) != math.sign(slope[1]) and slope < 0

upper_linreg_veryslow = y2__veryslow + 2 * dev_veryslow
lower_linreg_veryslow = y2__veryslow - 2 * dev_veryslow

upper_linreg = y2_ + 2 * dev
lower_linreg = y2_ - 2 * dev

upper_linreg_slow = y2__slow + 2 * dev_slow
lower_linreg_slow = y2__slow - 2 * dev_slow

upper_linreg_slowest = y2__slowest + 2 * dev_slowest
lower_linreg_slowest = y2__slowest - 2 * dev_slowest

