            //if (useAdx == false or (adx_trend == "kaufen" and useAdx == true)) and (useAtrRangeCondLong == false or (useAtrRangeCondLong == true and not atrRangeCond))
            if ( useAdx == false or ( ( returnOccuranceOfConditionString("string", adx_trend, "==", "kaufen", 3) > 0 ) and useAdx == true ) ) and (not useAtrRangeCondShort or (not atrRangeCond and not atrRangeCond2_mtf and not atrRangeCond3_mtf and not atrRangeCond4_mtf and not atrRangeCond5_mtf))
  
                // Pair Switcher
                if ( not usePairSwitcher or isBestPerformer ) and ( not useAfterSqueezeZoneLong or afterSqueezeZone )
                    
                    // Divergence Check
