//@version=5
//strategy("DAHU Squeeze Detection - Short Trading Strategy", shorttitle = "DAHUSQUEEZERECOG", overlay=true)

lengthATR = input.int(14, title="ATR Length")
multiplierUpper = input.float(1.5, title="Multiplier Upper Channel")
multiplierLower = input.float(1.5, title="Multiplier Lower Channel")
detectionLength = input.int(500, title="Detection Range Length")
limit = input.float(250, "Overlap Count Limit")

atrValue = ta.atr(lengthATR)

// Calculate channel boundaries for current bar
upperChannel = close + (atrValue * multiplierUpper)
lowerChannel = close - (atrValue * multiplierLower)

// Series variables for channels
var float[] upperChannelSeries = array.new_float(0)
var float[] lowerChannelSeries = array.new_float(0)

// Store current bar channels in series variables
array.unshift(upperChannelSeries, upperChannel)
array.unshift(lowerChannelSeries, lowerChannel)

// Keep only entries within detection range
if (array.size(upperChannelSeries) > detectionLength)
    array.pop(upperChannelSeries)
if (array.size(lowerChannelSeries) > detectionLength)
    array.pop(lowerChannelSeries)

// Calculate overlap count for current channel
overlapCount = 0
for i = 1 to array.size(upperChannelSeries) - 1
    if (array.size(upperChannelSeries) > i and array.size(lowerChannelSeries) > i)
        pastUpperChannel = array.get(upperChannelSeries, i)
        pastLowerChannel = array.get(lowerChannelSeries, i)

        if (upperChannel > pastLowerChannel and lowerChannel < pastUpperChannel)
            overlapCount := overlapCount + 1

// Berechne Verschiebung des aktuellen ATR-Kanals zur letzten Kerze
var bool channelShiftedUp = false
var bool channelShiftedDown = false

DAHUSQUEEZERECOGLongSignal = false
DAHUSQUEEZERECOGShortSignal = false

if array.size(upperChannelSeries) > 1
    previousUpperChannel = array.get(upperChannelSeries, 1)
    previousLowerChannel = array.get(lowerChannelSeries, 1)

    // Berechne die Mittelpunkte der ATR-Kanäle
    currentChannelMid = (upperChannel + lowerChannel) / 2
    previousChannelMid = (previousUpperChannel + previousLowerChannel) / 2

    // Bestimme Richtung der Kanalverschiebung
    channelShiftedUp := currentChannelMid > previousChannelMid
    channelShiftedDown := currentChannelMid < previousChannelMid

// State for background colors
var int greenBarsLeft = 0
var int redBarsLeft = 0

// === SIGNAL LOGIC ===
// Generiere Signale wenn Overlap das Limit unterschreitet (Squeeze Break)
var bool longSignal = false
var bool shortSignal = false

// Bestimme Signal-Typ basierend auf Kanalverschiebung
bool squeezeBreak = overlapCount <= limit and overlapCount[1] > limit

longSignal := squeezeBreak and channelShiftedUp
shortSignal := squeezeBreak and channelShiftedDown

// === STRATEGY EXECUTION ===
// Short Entry bei Down-Pfeil (shortSignal)
if (shortSignal)
    DAHUSQUEEZERECOGShortSignal := true
    //strategy.entry("SHORT", strategy.short, comment="SHORT ENTRY")
    redBarsLeft := 10

// Short Exit bei Up-Pfeil (longSignal)
if (longSignal)
    DAHUSQUEEZERECOGLongSignal := true
    //strategy.close("SHORT", comment="SHORT COVER")
    greenBarsLeft := 10

// Show background colors during trailing time with 70% opacity
var color bgColor = na
if (redBarsLeft > 0)
    bgColor := color.new(color.red, 30)
    redBarsLeft := redBarsLeft - 1
else if (greenBarsLeft > 0)
    bgColor := color.new(color.green, 30)
    greenBarsLeft := greenBarsLeft - 1
else
    bgColor := na

bgcolor(showDHSR ? bgColor : na)

// Plot Strategy Signale
plotshape(showDHSR ? shortSignal : na, title="Short Entry", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.normal, text="SHORT")
plotshape(showDHSR ? longSignal : na, title="Short Exit", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.normal, text="COVER")

// === PLOTS ===
// Plot aktuelle Kanäle
//plot(upperChannel, "Upper Channel", color=color.blue, linewidth=1)
//plot(lowerChannel, "Lower Channel", color=color.blue, linewidth=1)


