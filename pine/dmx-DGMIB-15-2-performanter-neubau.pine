if lr_VLI_fast < lr_VLI_slow
    lr_low_volatility := true
    lr_low_volatility

//low volatility level: VLI fast < VLI slow
lr_extreme_low_volatility = false
if lrw < lr_VLI_fast and lr_low_volatility
    lr_extreme_low_volatility := true
