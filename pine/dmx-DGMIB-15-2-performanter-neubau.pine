f_remove_duplicate(arr, empty_arr) =>
    //temp_arr = array.new_string()
    temp_arr = empty_arr
    len = array.size(arr)

    if (len > 0)
        for i=0 to len-1
            val = array.get(arr, i)
            first_idx = array.indexof(arr, val)
            
            if (i == first_idx)  // Only one occurrence
                array.push(temp_arr, val)
    temp_arr 

array_push_unique(arr, element) => 
    if (array.includes(arr, element) == false)
        array.push(arr, element)
    arr

checkForBreakoutSignals(signals, shortLong, intradaySuffix = "") =>

    breakouts = array.new_string()

    if shortLong == 'long' and useL4WEntryConditionLong == true and returnDistanceToConditionBool(array.includes(signals, "4-Wochen-Regel" + intradaySuffix), "==", 1, 4) < 1 
        breakouts := array_push_unique(breakouts, "4-Wochen-Regel" + intradaySuffix)
    if shortLong == 'long' and useLREntryConditionLong == true and returnDistanceToConditionBool(array.includes(signals, "linreg" + intradaySuffix), "==", 1, 4) < 1 
        breakouts := array_push_unique(breakouts, "linreg" + intradaySuffix)
    if shortLong == 'long' and useCBEntryConditionLong == true and returnDistanceToConditionBool(array.includes(signals, "confirmed-bb" + intradaySuffix), "==", 1, 4) < 1
        breakouts := array_push_unique(breakouts, "confirmed-bb" + intradaySuffix)

    if shortLong == 'short' and useL4WEntryConditionShort == true and returnDistanceToConditionBool(array.includes(signals, "4-Wochen-Regel" + intradaySuffix), "==", 1, 4) < 1 
        breakouts := array_push_unique(breakouts, "4-Wochen-Regel" + intradaySuffix)
    if shortLong == 'short' and useLREntryConditionShort == true and returnDistanceToConditionBool(array.includes(signals, "linreg" + intradaySuffix), "==", 1, 4) < 1 
        breakouts := array_push_unique(breakouts, "linreg" + intradaySuffix)
    if shortLong == 'short' and useCBEntryConditionShort == true and returnDistanceToConditionBool(array.includes(signals, "confirmed-bb" + intradaySuffix), "==", 1, 4) < 1
        breakouts := array_push_unique(breakouts, "confirmed-bb" + intradaySuffix)
    
    breakouts

if (distanceToLastSmmaTrendEndSignal != 500 and distanceToLastSmmaTrendEndSignal < 240)
    trendChangePhase := true
else 
    trendChangePhase := false

