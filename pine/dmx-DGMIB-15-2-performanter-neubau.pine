// Funktionen 
//---------------  

array_includes(array, needle) =>
    array.includes(array, needle)

// todo kann rübernehmen
returnOccuranceOfCondition(comparisonValueType, historicalValue, string operator, comparisonValue, int lookback) =>
    int countOccurances = 0
    for i = 0 to lookback
        if (comparisonValueType == "int" or comparisonValueType == "float")
            if operator == ">" and historicalValue[i] > comparisonValue[i]
                countOccurances += 1
            if operator == "<" and historicalValue[i] < comparisonValue[i]
                countOccurances += 1
            if operator == "<=" and historicalValue[i] <= comparisonValue[i]
                countOccurances += 1
            if operator == ">=" and historicalValue[i] >= comparisonValue[i]
                countOccurances += 1
            if operator == "==" and historicalValue[i] == comparisonValue[i]
                countOccurances += 1
            if operator == "!=" and historicalValue[i] != comparisonValue[i]
                countOccurances += 1
    countOccurances

// todo kann rübernehmen   
returnDistanceToConditionBool(historicalValue, string operator, comparisonValue, int lookback) => 

    // muss bei 1 starten sonst meint es wenn 0 zurückgegeben wird, dass es false ist
    distance = 1
    for i = 0 to lookback
        distance := i
    
        if operator == "==" and historicalValue[i] == comparisonValue 
            break
        if operator == "!=" and historicalValue[i] != comparisonValue
            break
    
    distance

// todo kann rübernehmen
returnOccuranceOfConditionBool(comparisonValueType, historicalValue, string operator, comparisonValue, int lookback) =>
    int countOccurances = 0
    for i = 0 to lookback
        if operator == "==" and historicalValue[i] == comparisonValue
            countOccurances += 1
        if operator == "!=" and historicalValue[i] != comparisonValue
            countOccurances += 1
    countOccurances

// todo kann rübernehmen
returnOccuranceOfConditionString(comparisonValueType, historicalValue, string operator, comparisonValue, int lookback) =>
    int countOccurances = 0
    for i = 0 to lookback
        if operator == "==" and historicalValue[i] == comparisonValue
            countOccurances += 1
        if operator == "!=" and historicalValue[i] != comparisonValue
            countOccurances += 1
    countOccurances

getSmmaTrend(srcSMA, lenSMA, maMethod, ama, colorDown, colorUp) =>

    smma = 0.0
    smmaTrendColor = color.black
    smmaTrend = 'no_trend'

    if (maMethod == "smma")
        smma := na(smma[1]) ? ta.ema(srcSMA, lenSMA) : (smma[1] * (lenSMA - 1) + srcSMA) / lenSMA
    else if (maMethod == "sma")
        smma := ta.sma(srcSMA, lenSMA)
    else if (maMethod == "ema")
        smma := ta.ema(srcSMA, lenSMA)
    else if (maMethod == "vwma")
        smma := ta.vwma(srcSMA, lenSMA)
    else if (maMethod == "ama")    
        smma := ama
    
    smmaDifference = smma[1] - smma
    
    if smmaDifference > 0
        smmaTrend := 'down'
        smmaTrendColor := colorDown
        smmaTrendColor
    else
        smmaTrend := 'up'
        smmaTrendColor := colorUp
        smmaTrendColor
        
    [smma, smmaTrend, smmaTrendColor]

