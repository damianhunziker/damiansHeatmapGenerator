// KAMA Function
getKama(src, len, fastLength, slowLength) =>
    xvnoise = math.abs(src - src[1])
    fastend = 2 / (fastLength + 1)
    slowend = 2 / (slowLength + 1)
    nsignal = math.abs(src - src[len])
    nnoise = math.sum(xvnoise, len)
    nefratio = nnoise != 0 ? nsignal / nnoise : 0
    nsmooth = math.pow(nefratio * (fastend - slowend) + slowend, 2)
    nAMA = 0.0
    nAMA := nz(nAMA[1]) + nsmooth * (src - nz(nAMA[1]))
    nAMA

// KAMA Calculations
