    profitLast5HigherThan5 = (returnOccuranceOfCondition("float", profitPerc, ">", 5, 1) )

    profitLast5HigherThan12 = (returnOccuranceOfCondition("float", profitPerc, ">", 12, 1) )

    profitLast5HigherThan15 = (returnOccuranceOfCondition("float", profitPerc, ">", 15, 1) )

