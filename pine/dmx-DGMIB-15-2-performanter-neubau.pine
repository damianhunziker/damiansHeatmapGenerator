                resultingTradeLevelLong := 2
                resultingTradeLevelShort := 2
            if (profitLast5HigherThan5 > 0)
                resultingTradeLevelLong := 3
                resultingTradeLevelShort := 3
            if (profitLast5HigherThan15 > 0)
                resultingTradeLevelLong := 4
                resultingTradeLevelShort := 4

