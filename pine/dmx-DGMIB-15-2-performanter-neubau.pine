src = close
multLong = input.float(2, minval=0.001, maxval=50, step=0.1, title='StdDev Long', group="Bollinger Bands")
multShort = input.float(1.9, minval=0.001, maxval=50, step=0.1, title='StdDev Short', group="Bollinger Bands")

bollinger_basis = ta.sma(src, length)
bollinger_basis_short = ta.sma(src, lengthShort)

devLong = multLong * ta.stdev(src, length)
bollinger_top = bollinger_basis + devLong
bollinger_bot = bollinger_basis - devLong
bbr_long = (src - bollinger_bot)/(bollinger_top - bollinger_bot)

devShort = multShort * ta.stdev(src, lengthShort)
bollinger_top_short = bollinger_basis_short + devShort
bollinger_bot_short = bollinger_basis_short - devShort
bbr_short = (src - bollinger_bot_short)/(bollinger_top_short - bollinger_bot_short)

