                    // Quickfix

                    intrabarBreakoutLongConditions := intrabarBreakoutLongConditions == true ? true : false

                    // Volume Check
                    // --------------- 
                    
                    if (useVolumeCondForLongEntry == false or (vol_condition and useVolumeCondForLongEntry == true))

                        // Check if actual method is sending in this candel
                        // ---------------
                        if (array_includes(longSignals, longMethod))
                            longEntry := true
                            //stopLossPriceLong := close * stopLossMultLong
                            stopLossPriceLong := close - (stdev_average * stopLossStdevMultLong)
                            tradeMethodLong := longMethod
                            tradeType := "long"

                else
                    intrabarBreakoutLongConditions := false
                    intrabarBrLoCoLongRemoval := intrabarBrLoCoLongRemoval + 7896

