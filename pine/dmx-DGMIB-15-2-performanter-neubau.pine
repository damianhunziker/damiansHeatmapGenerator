intrabarBreakoutEntryStdevMultiShort = input.float(defval=1.5, step=0.01, minval=0, maxval=20, group="Intrabar Orders")

limitIntrabarBreakoutPriceShort = close - (stdev_average * intrabarBreakoutEntryStdevMultiShort)
limitIntrabarBreakoutPriceLong = close + (stdev_average * intrabarBreakoutEntryStdevMultiLong)

pine_sma(seriesVar, length, addToFirst = 0) =>
    sum = 0.0
    for i = 0 to length - 1
        addToX = 0.0
        if (i == 0 and addToFirst > 0)
            addToX := addToFirst
        sum := (sum + ( ( seriesVar[i] + addToX ) / length ) )
        //sum := sum + seriesVar[i] / length
    sum
