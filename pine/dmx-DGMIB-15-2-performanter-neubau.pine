    //
    // level = age and profit at a curtain percentage
    //
    // low age = low sensitive linreg
    // higher age = less sensitive linreg
    // higher age and higher profit = most insensitive linreg
    // very high age and very high profit = no more linreg adx and smma, divergences deciding

    if (entryPriceLong)
        profit := close - entryPriceLong

    if (entryPriceShort)
        profit := entryPriceShort - close

    profitPerc := 100 / (close / profit)

