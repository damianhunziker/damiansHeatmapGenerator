atrRangeShowMa                        = input.bool(false,                           group=Group6100,                                                                  title='Show MA')

Group6120 = '6120 ATR Ranging'
tooltipThma='TEHMA, the "T" = the "tripple" in the Tripple Expotential Moving Average. I.e., TEHMA is even more weighted to the most recent price moves than the EHMA.'

atrRangeAtrLength                     = input.int(18,                               group=Group6120, minval=2,                                                        title='ATR length')
atrRangeHmaModeSwitch                 = input.string('EHMA',                        group=Group6120,                                                                  title='MA variation', options=['EMA', 'EHMA', 'HMA', 'LINREG', 'RMA', 'SMA', 'SWMA', 'TEHMA', 'VWMA', 'WMA'], tooltip=tooltipThma)
atrRangeHmaLength                     = input.int(200,                              group=Group6120, minval=2, step=5,                                                title='HMA length')
atrRangeScalingFactor                 = input.float(0.8,                            group=Group6120, minval=0, step=.1,                                               title='ATR scaling factor')

