    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    // Closes
    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ 
    // Set the close flag if method is the actual trades tradeType and if close signal 
    // is caught
    // ----
    
    // Short
    // ----
    if (tradeMethodShort == shortMethod and tradeType == "short") and not shortEntry
        
        if (useShortClose or (useSoftShortClose and ( ( (takeProfitPriceShort > 0 and close > takeProfitPriceShort) or takeProfitPriceShort < 0.000001) and (stopLossPriceShort > entryPriceShort) and (entryPriceShort < close)) or tradeAgeShort < softCloseTradeAgeInBarsShort))
        
            if (array_includes(shortCloseSignals, shortCloseMethod))
            
                shortCloseReason := shortCloseReason + " " + shortCloseMethod
                shortClose := true
                
            else if (array_includes(shortCloseSignals, shortCloseMethod + "_SAR"))
            
                tradePutToSARShort := true
    
    // Long
    // ----
    
    if (tradeMethodLong == longMethod and tradeType == "long")
    
        if (useLongClose or (useSoftLongClose and ( ( (takeProfitPriceLong > 0 and close < takeProfitPriceLong) or takeProfitPriceLong < 0.000001) and (stopLossPriceLong < entryPriceLong) and (entryPriceLong > close)) or tradeAgeLong < softCloseTradeAgeInBarsLong))
        
            if (array_includes(longCloseSignals, longCloseMethod))
                
                longCloseReason := longCloseReason + " " + longCloseMethod
                longClose := true

                
                
    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    // Divergence Closes
    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ 


    if ( profitPerc < 12 )

        // Short
        // ----

        if (tradeType == "short")
        
            if useDivergenceCheckToCloseShort and ( buyDivergenceConfirmed and buyDivergenceConfirmed[1] == false )    
            
                //buyDivergenceIntact := true
                shortCloseReason := "divergences"
                shortClose := true
                divergenceCloseShort := true
        
        // Long
        // ----
        
        if (tradeType == "long")

            if useDivergenceCheckToCloseLong and ( sellDivergenceConfirmed and sellDivergenceConfirmed[1] == false ) 
        
                //sellDivergenceIntact := true
                longCloseReason := "divergences"
                longClose := true
                divergenceCloseLong := true


        if (tradeType == "long")
    
            if close < lowerShortLRPP and ( close[1] < lowerShortLRPP[1] or close[2] < lowerShortLRPP[2] )
            //if close < lowerLRPP and ( close[1] < lowerLRPP[1] or close[2] < lowerLRPP[2] )
            
                //buyDivergenceIntact := true
                longCloseReason := "1. lrpp"
                longClose := true
                divergenceCloseLong := true

        if (tradeType == "short")
    
            if close > upperLRPP and ( close[1] > upperLRPP[1] or close[2] > upperLRPP[2] )
            //if close > upperShortLRPP and ( close[1] > upperShortLRPP[1] or close[2] > upperShortLRPP[2] )
            
                //buyDivergenceIntact := true
                shortCloseReason := "1. lrpp"
                shortClose := true
                divergenceCloseShort := true
        
    if (profitPerc >= 12)     

        if (tradeType == "long")
    
            if close < lowerShortLRPP and ( close[1] < lowerShortLRPP[1] or close[2] < lowerShortLRPP[2] )
            //if close < lowerLRPP and ( close[1] < lowerLRPP[1] or close[2] < lowerLRPP[2] )
            
                //buyDivergenceIntact := true
                longCloseReason := "1. lrpp"
                longClose := true
                divergenceCloseLong := true

        if (tradeType == "short")
    
            if close > upperLRPP and ( close[1] > upperLRPP[1] or close[2] > upperLRPP[2] )
            //if close > upperShortLRPP and ( close[1] > upperShortLRPP[1] or close[2] > upperShortLRPP[2] )
            
                //buyDivergenceIntact := true
                shortCloseReason := "1. lrpp"
                shortClose := true
                divergenceCloseShort := true

    if (profitPerc >= 24)     

        if (tradeType == "long")

            if close < lowerShortLRPP and ( close[1] < lowerShortLRPP[1] or close[2] < lowerShortLRPP[2] )
            
                //buyDivergenceIntact := true
                longCloseReason := "2. lrpp"
                longClose := true
                divergenceCloseLong := true

        if (tradeType == "short")

            if close > upperLRPP and ( close[1] > upperLRPP[1] or close[2] > upperLRPP[2] )
            
                //buyDivergenceIntact := true
                shortCloseReason := "2. lrpp"
                shortClose := true
                divergenceCloseShort := true
        
        // Long
        // ----
        
        if (tradeType == "long")

            if useDivergenceCheckToCloseLong and ( sellDivergenceConfirmed and sellDivergenceConfirmed[1] == false ) 
        
                //sellDivergenceIntact := true
                longCloseReason := "divergences"
                longClose := true
                divergenceCloseLong := true

                    

    // -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    // Custom Closes 
    // -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    
    // Wenn SMMA-Trend auf verkaufen wechselt
    if tradeMethodLong == "nls2" and tradeType == "long" and smmaTrend == "down"
        longCloseReason := "smma down close"
        longClose := true 
    
    //if ( ((shortCloseMethod == "B-Methode 1" or shortCloseMethod == "nls2 long mirror" or shortCloseMethod == "short 4" or shortCloseMethod == "nls2" or shortCloseMethod == "nls2 confirmed" ) and tradeType == "short")) and zoneIsInsideSlow and isInSqueezeZoneCloseSlow and isInSqueezeZoneClose // or array.includes(shortCloseSignals, "4-Wochen-Regel"))// or array.includes(shortCloseSignals, "breakout")) //or array.includes(shortCloseSignals, "4-Wochen-Regel"))
    //    shortCloseReason := "squeeze"
    //    shortClose := true 
    
    //if (((shortCloseMethod == "B-Methode 1" or shortCloseMethod == "nls2 long mirror" or shortCloseMethod == "short 4" or shortCloseMethod == "nls2" or shortCloseMethod == "nls2 confirmed" ) and tradeType == "short")) and lr_breakout_top == 1// or array.includes(shortCloseSignals, "4-Wochen-Regel"))// or array.includes(shortCloseSignals, "breakout")) //or array.includes(shortCloseSignals, "4-Wochen-Regel"))
    //    shortCloseReason := "linear reg"
    //    shortClose := true 
    
    if (((shortCloseMethod == "B-Methode 1" or shortCloseMethod == "nls2 long mirror"  or shortCloseMethod == "linreg" or shortCloseMethod == "short 4" or shortCloseMethod == "nls2" or shortCloseMethod == "nls2 confirmed" ) and tradeType == "short")) and (array.includes(shortCloseSignals, "adx-di-cross"))// or array.includes(shortCloseSignals, "4-Wochen-Regel"))// or array.includes(shortCloseSignals, "breakout")) //or array.includes(shortCloseSignals, "4-Wochen-Regel"))
        shortCloseReason := "adx-di/4w"
        shortClose := true
        
    //if (((shortCloseMethod == "B-Methode 1" or shortCloseMethod == "nls2 long mirror" or shortCloseMethod == "short 4" or shortCloseMethod == "nls2" ) and tradeType == "short")) and array.includes(shortCloseSignals, "breakout") //and tradeAgeShort > 23 
    //    shortCloseReason := "breakout"
    //    shortClose := true 

    smmaTrendDown48 = returnOccuranceOfConditionString("string", smmaTrendShort, "==", "down", 48)
    smmaTrendUp48 = returnOccuranceOfConditionString("string", smmaTrend, "==", "up", 48)
    
    // ist mit nur schliessen wenn gewinn fhöher als 2%   
    //if (((shortCloseMethod == "B-Methode 1" or shortCloseMethod == "nls2 long mirror"  or shortCloseMethod == "linreg" or shortCloseMethod == "short 4" or shortCloseMethod == "nls2" or shortCloseMethod == "nls2 confirmed" ) and tradeType == "short")) and close < (entryPriceShort * 0.98) and tradeAgeShort > 48 and smmaTrendDown48 > 46 and smmaTrendShort == "up"
    //    shortCloseReason := "smma trend"
    //    shortClose := true
    
    //if (((shortCloseMethod == "B-Methode 1") and tradeType == "sidewaysShort") or ((shortCloseMethod == "B-Methode 1") and tradeType == "short")) and close < (entryPriceShort * 0.98) and (tradeAgeShort > 48 and lowBBWPhase == true and lowBBWPhase[1] == false)
    //    shortCloseReason := "lowBBWPhase"
    //    shortClose := true 
    
    //if ( ((longCloseMethod == "B-Methode 1" or longCloseMethod == "nls2 long mirror" or longCloseMethod == "short 4" or longCloseMethod == "nls2"  or longCloseMethod == "nls2 confirmed") and tradeType == "long")) and squeeze_started
    //    longCloseReason := "squeeze"
    //    longClose := true 
    
    //if ( ((longCloseMethod == "B-Methode 1" or longCloseMethod == "nls2 long mirror" or longCloseMethod == "short 4" or longCloseMethod == "nls2"  or longCloseMethod == "nls2 confirmed") and tradeType == "long")) and lr_breakout_bot == 1
    //    longCloseReason := "linear reg"
    //    longClose := true 
    
    // Änderung nach live 6.3.22
    if ( ((longCloseMethod == "B-Methode 1" or longCloseMethod == "nls2 long mirror" or longCloseMethod == "short 4" or longCloseMethod == "nls2" or longCloseMethod == "linreg" or longCloseMethod == "nls2 confirmed") and tradeType == "long")) and array.includes(longCloseSignals, "adx-di-cross")
        longCloseReason := "adx-di-cross"
        longClose := true
    
    //if ( ((longCloseMethod == "B-Methode 1" or longCloseMethod == "nls2 long mirror" or longCloseMethod == "short 4" or longCloseMethod == "nls2" or longCloseMethod == "linreg" or longCloseMethod == "nls2 confirmed") and tradeType == "long")) and tradeAgeLong > 48 and smmaTrendUp48 > 46 and smmaTrend == "down"
    // and close > entryPriceLong
    
    
    //if (tradeMethodLong == "nls2" and tradeType == "long" and close > entryPriceLong and tradeAgeLong > 48 and returnOccuranceOfConditionString("string", smmaTrend, "==", "up", 48) > 46 and smmaTrend == "down")
    //    longCloseReason := "smma trend"
    //    longClose := true
    
    if tradeAgeLong > 23 and tradeType == "long" and array.includes(longCloseSignals, "breakout") and (useBBBasisCloseAfterBreakoutLong or tradeMethodLongTightOrBroad == "tight")
        longCloseReason := "breakout"
        longClose := true
        
    
    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    // Preparation of variables
    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    
    // Its not possible to nest more than env. 7 level of if conditions, 
    // therefor additional processing needs to happen here for 
    // example for the entry signal which consist of many levels
    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
    
//
//    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ 
//    // Get the entry Signals from a higher timeframe
//    // ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ 
//
