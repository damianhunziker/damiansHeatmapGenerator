        else
            intrabarBreakoutLongConditions := false
            intrabarBrLoCoLongRemoval := intrabarBrLoCoLongRemoval + 2815


    // useImmediatelyPlaceOrderLong
    //if (useLong and useImmediatelyPlaceOrderLong and pairSwitcherBestPerformer == currentPairSwitcherCurrencyIndex and pairSwitcherBestPerformer[1] != currentPairSwitcherCurrencyIndex[1]) 
