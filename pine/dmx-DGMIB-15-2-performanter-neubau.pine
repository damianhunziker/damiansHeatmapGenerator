//    shortWindowEntryPrice := na



// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Execution of the trades
// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ 


// Long
// ----
            
if (longEntry)

    if (not na(tradeMethodLong[1]))
    
        // logic for what happens on repeated signals from already in action trades   
        if (tradeMethodLong[1] == tradeMethodLong and tradeType[1] == tradeType)
            
            // repeated signal
            if tradeType == "long"
                
                //if bevaviorAtRepetionLong == "Recalculate"
                    //stopLossPriceLong := close * stopLossMultLong
                    
                if bevaviorAtRepetionLong == "Recalculate Higher Only"
                    //stopLossPriceLongNew = close * stopLossMultLong
                    stopLossPriceLong := math.max(stopLossPriceLong[1], stopLossPriceLong)
                    
                if bevaviorAtRepetionLong == "no action"
                    // reset it to initial value
                    stopLossPriceLong := initialStopLossPriceLong
                
                    
        else
            
            // TradeType nur neu schreiben wenn Trade auch wirklich ausgeführt wird, ansonsten reset zu werten davor
            tradeType := tradeType[1]
            stopLossPriceLong := initialStopLossPriceLong
            tradeMethodLong := tradeMethodLong[1]
        
    else
    
        resultingTradeMethod = ""
        if (tradeMethodLong == "nls2")
            if (array_includes(longSignals, "broad1"))
                resultingTradeMethod := "low volatility"
                tradeMethodLongTightOrBroad := "broad1"
            if (array_includes(longSignals, "broad2"))
                resultingTradeMethod := "high volatility"
                tradeMethodLongTightOrBroad := "broad2"
            if (array_includes(longSignals, "broad3"))
                resultingTradeMethod := "broad3"
                tradeMethodLongTightOrBroad := "broad3"
            if (array_includes(longSignals, "tight"))
                resultingTradeMethod := "extreme volatility"
                tradeMethodLongTightOrBroad := "tight"
            if (array_includes(longSignals, "B-Methode 1"))
                resultingTradeMethod := "B-Methode 1"
                tradeMethodLongTightOrBroad := "B-Methode 1"
            if (array_includes(longSignals, "DHSR"))
                resultingTradeMethod := "DHSR"
                tradeMethodLongTightOrBroad := "DHSR"
        else
            resultingTradeMethod := tradeMethodLong
                
        // initial signal
        if not entryPriceLong
            entryPriceLong := close
        strategy.entry("long",strategy.long, comment = resultingTradeMethod + " " + tradeType)
        stopPriceByStdevLong := stopLossPriceLong
        stopLossPriceLong := close * stopLossMultLong
        stopLossPriceLong := math.max(stopLossPriceLong, stopLossPriceLong[1])
        executingTradeLong := true
    
if ( longClose )    
    strategy.close("long", comment = longCloseReason + " " + tradeType + " close")
    strategy.close("long limit", comment = longCloseReason + " " + tradeType + " limit close")
    earningsAfterCloseTrade := close - entryPriceLong
    executingClose := true 
    executingClose

// Long Stop Loss / Take Profit Procession
// ----
    
smaStDev5to10 = ta.sma(stdev_average / 5, 10)

if strategy.position_size > 0 or longEntry
    tradeAgeLong += 1
    
    if not longEntry and (tradeType == "long")
                
        if bevaviorAtRepetionLong == "Recalculate Higher Only"
            stopLossPriceLong := math.max(stopLossPriceLong[1], stopLossPriceLong)
            
        else if bevaviorAtRepetionLong == "no action"
            // reset it to initial value
            stopLossPriceLong := initialStopLossPriceLong
        
    // Set long Take Profit and Stop Loss
    if (useStopLossLong or useTakeProfitLong) and (stopLossPriceLong > 0 or takeProfitPriceLong > 0)
        if takeProfitPriceLong > stopLossPriceLong
            resultingStopPriceLong := takeProfitPriceLong
        else
            resultingStopPriceLong := stopLossPriceLong
    
    // if short entry is true exit long immediately
    if (shortEntry or shortEntrySignalDespiteDeactivated) and useShortEntryAsCloseSignalLong
        strategy.close('long', comment='short entry close')
        strategy.close('long limit', comment='short entry limit close')
        
    //resultingStopPriceLong := stopLossPriceLong
    
    if longEntry != true and tradeType == "long" and longCloseMethod == "bb touch"  
        resultingStopPriceLong := bollinger_bot > stopLossPriceLong ? bollinger_bot : stopLossPriceLong

    if longEntry != true and tradeType == "long"  
        //if (resultingTradeLevelLong == 1)
            //resultingStopPriceLong := stopLossPriceLong > lowerLRPP ? stopLossPriceLong : lowerLRPP
        if (resultingTradeLevelLong == 2)
            resultingStopPriceLong := stopLossPriceLong > lowerShortLRPP ? stopLossPriceLong : lowerShortLRPP
        if (resultingTradeLevelLong == 3)
            resultingStopPriceLong := stopLossPriceLong > lowerShortLRPP ? stopLossPriceLong : lowerShortLRPP
        if (resultingTradeLevelLong == 4)
            resultingStopPriceLong := entryPriceLong * 1.07

        // if tradeAge is below softCloseTradeAgeInBars touch middle bollinger to exit
        // todo muss hier noch standardabweichung / 2 hinzurechnen
        //if tradeAgeLong <= softCloseTradeAgeInBarsLong and ( bollinger_basis - ( smaStDev5to10 ) > resultingStopPriceLong or na(resultingStopPriceLong) )
        //    resultingStopPriceLong := bollinger_basis - ( smaStDev5to10 ) 
        //if tradeAgeLong <= softCloseTradeAgeInBarsLong and ( bollinger_basis > resultingStopPriceLong or na(resultingStopPriceLong) )
        //    resultingStopPriceLong := bollinger_basis


    // if smma is higher than stoploss make it the stoploss
    if resultingStopPriceLong < smmaExit and resultingTradeLevelLong > 3
        resultingStopPriceLong := smmaExit

    // dont allow the resultingStopPrice to go beyond the standard deviation calculation
    if tradeType == "long" and ( resultingStopPriceLong < stopPriceByStdevLong or na(resultingStopPriceLong) )
        resultingStopPriceLong := stopPriceByStdevLong

    // dont allow the resulting stop price to go beyond percentual limits of stopLossMult
    if tradeType == "long" and ( resultingStopPriceLong < entryPriceLong * stopLossMultLong or na(resultingStopPriceLong) )
        resultingStopPriceLong := entryPriceLong * stopLossMultLong

    intoExitRoutineLong := true

    if (resultingStopPriceLong > 0 or resultingLimitPriceLong > 0)
        strategy.exit(id='long exit', from_entry='long', stop=resultingStopPriceLong, limit=resultingLimitPriceLong, comment="long exit")
        strategy.exit(id='long limit exit', from_entry='long limit', stop=resultingStopPriceLong, limit=resultingLimitPriceLong, comment="long limit exit")

// Short
// -----

if shortEntry
    
    if (not na(tradeMethodShort[1]))
    
        // logic for what happens on repeated signals from already in action trades  
        if (tradeMethodShort[1] == tradeMethodShort and tradeType[1] == tradeType)
    
            // repeated signal
            if tradeType == "short"
            
                //if bevaviorAtRepetionShort == "Recalculate"
                //    stopLossPriceShort := close * stopLossMultShort
                    
                if bevaviorAtRepetionShort == "Recalculate Higher Only"
                    //stopLossPriceShort := close * stopLossMultShort
                    stopLossPriceShort := math.min(stopLossPriceShort, stopLossPriceShort[1])
                    
                if bevaviorAtRepetionShort == "no action"
                    // reset it to last value
                    stopLossPriceShort := initialStopLossPriceShort
                    
        else 
            
            // TradeType nur neu schreiben wenn Trade auch wirklich ausgeführt wird, ansonsten reset zu werten davor
            tradeType := tradeType[1]
            stopLossPriceShort := initialStopLossPriceShort
            tradeMethodShort := tradeMethodShort[1]
        
    else
        
        resultingTradeMethodShort = tradeMethodShort

        // initial signal
        strategy.entry('short', strategy.short, comment = resultingTradeMethodShort + " " + tradeType)
        if not entryPriceShort
            entryPriceShort := close
            entryPriceShort
        short_window := false
        //stopLossPriceShort := hh20
        stopPriceByStdevShort := stopLossPriceShort
        //stopLossPriceShort := close + (stdev_average * 1.5)
        //if stopLossPriceShort[1] > 0
        //    stopLossPriceShort := math.min(stopLossPriceShort, stopLossPriceShort[1])
        //    stopLossPriceShort
        executingTradeShort := true
        executingTradeShort

if shortClose
    strategy.close('short', comment = shortCloseReason + " " + tradeType + " close")
    strategy.close('short limit', comment = shortCloseReason + " " + tradeType + " limit close")
    executingClose := true
    earningsAfterCloseTrade := entryPriceShort - close
    earningsAfterCloseTrade

// Short Stop Loss / Take Profit Procession
// ----

resultingTrailStartPercShort = float(na)
resultingTrailPercShort = float(na)

resultingTrailStartPercShort := trailStartPercShort
resultingTrailPercShort := trailPercShort

if (customTrailStartPercShort)
    resultingTrailStartPercShort := customTrailStartPercShort
    resultingTrailPercShort := customTrailPercShort

// Determine trail stop loss prices
stopValue = 0.0
takeProfitPriceShort := if strategy.position_size < 0 and (close < entryPriceShort * ((100 - resultingTrailStartPercShort) / 100) )
    stopValue := close * ((100 + resultingTrailPercShort) / 100)
    if takeProfitPriceShort[1] > 0
        math.min(stopValue, takeProfitPriceShort[1])
    else
        stopValue
else
    0.0

//    if strategy.position_size >= 0.00 and not executingTradeShort

if strategy.position_size < 0 or shortEntry
    tradeAgeShort += 1
    
    // if short entry is true exit long immediately
    if useLongEntryAsCloseSignalShort == true and (longEntry or array_includes(longSignals, longMethod))
        strategy.close('short', comment='long entry close')
        strategy.close('short limit', comment='long entry limit close')
    
    if not shortEntry and (tradeType == "short")
                
        if bevaviorAtRepetionLong == "Recalculate Higher Only"
            stopLossPriceShort := math.min(stopLossPriceShort[1], stopLossPriceShort)
            
        else if bevaviorAtRepetionLong == "no action"
            // reset it to initial value
            stopLossPriceShort := initialStopLossPriceShort
    
    resultingStopPriceShort := stopLossPriceShort

    // Set long Take Profit and Stop Loss
    if (useStopLossShort or useTakeProfitShort) and (stopLossPriceShort > 0 or takeProfitPriceShort > 0)
        if takeProfitPriceShort > stopLossPriceShort
            resultingStopPriceShort := takeProfitPriceShort
        else
            resultingStopPriceShort := stopLossPriceShort
    else
        resultingStopPriceShort := na

    if shortEntry != true and tradeType == "short" and shortCloseMethod == "bb touch" and bollinger_top_short < resultingStopPriceShort
        resultingStopPriceShort := bollinger_top_short < stopLossPriceShort ? bollinger_top_short : stopLossPriceShort
        
    
    if shortEntry != true and tradeType == "short" and shortCloseMethod == "linreg"     
        if (resultingTradeLevelShort == 1)
            resultingStopPriceShort := stopLossPriceShort < upper_linreg_slow ? stopLossPriceShort : upper_linreg_slow
        if (resultingTradeLevelShort == 2)
            resultingStopPriceShort := stopLossPriceShort < upper_linreg_veryslow ? stopLossPriceShort : upper_linreg_veryslow
        if (resultingTradeLevelShort == 3)
            resultingStopPriceShort := stopLossPriceShort < upper_linreg_slowest ? stopLossPriceShort : upper_linreg_slowest
        if (resultingTradeLevelShort == 4)
            resultingStopPriceShort := entryPriceShort * 0.93
        
        // if tradeAge is below softCloseTradeAgeInBars touch middle bollinger to exit
        if tradeAgeShort <= softCloseTradeAgeInBarsShort and ( bollinger_basis_short + ( smaStDev5to10 ) < resultingStopPriceShort or na(resultingStopPriceShort) )
            resultingStopPriceShort := bollinger_basis_short + ( smaStDev5to10 )

    // if smmaShort is higher than stoploss make it the stoploss
    if resultingStopPriceShort > smmaShort and resultingTradeLevelLong > 3
        resultingStopPriceShort := smmaShort

    //if tradeAgeShort <= softCloseTradeAgeInBarsShort and ( bollinger_basis_short < resultingStopPriceShort or na(resultingStopPriceShort) )
    //    resultingStopPriceShort := bollinger_basis_short 

    // dont allow the resultingStopPrice to go beyond the standard deviation calculation
    if tradeType == "short" and ( resultingStopPriceShort > stopPriceByStdevShort  or na(resultingStopPriceShort) )
        resultingStopPriceShort := stopPriceByStdevShort

    // dont allow the resulting stop price to go beyond percentual limits of stopLossMult
    if tradeType == "short" and ( resultingStopPriceShort > entryPriceShort * stopLossMultShort or na(resultingStopPriceShort) )
        resultingStopPriceShort := entryPriceShort * stopLossMultShort

    if (resultingStopPriceShort > 0 or resultingLimitPriceShort > 0)
        strategy.exit(id='short exit', from_entry='short', stop=resultingStopPriceShort, limit=resultingLimitPriceShort, comment="short exit") 
        strategy.exit(id='short limit exit', from_entry='short limit', stop=resultingStopPriceShort, limit=resultingLimitPriceShort, comment="short limit exit") 
    
// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// After Processing For Next Candle
// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ 

//if na(tradeMethodLong) and na(tradeMethodShort)
//    tradeType := na

strategy.cancel(id='short limit')
strategy.cancel(id='initial short limit exit')
// ???? 14.06.24
//strategy.cancel(id='short limit exit')
if (intrabarBreakoutShortConditions and useShort)
    
    if (not executingTradeShort and not executingTradeShort and not strategy.position_size and limitIntrabarBreakoutPriceShort > 0)
        limitOrderPlacedShort := true
        // stop parameter bedeutet wann der order aktiv wird
        // beim limit order wird er dann ausgeführt
        // den stop für einen eventuellen trade mit einem zweiten entry setzen
        strategy.cancel(id='short limit exit')
        strategy.entry(id='short limit', direction=strategy.short, stop = limitIntrabarBreakoutPriceShort, limit = limitIntrabarBreakoutPriceShort - stdev_average, comment = "limit short")
        strategy.exit(id='initial short limit exit', from_entry='short limit', stop = limitIntrabarBreakoutPriceShort + (stdev_average * 0.75), comment="initial short limit exit") 

    //limitIntrabarBreakoutPriceShort := na

strategy.cancel(id='long limit')
strategy.cancel(id='initial long limit exit')
if (intrabarBreakoutLongConditions and useLong)
    
    if (not executingTradeLong and not executingTradeLong and not strategy.position_size and limitIntrabarBreakoutPriceLong > 0)
        
        limitOrderPlacedLong := true
        strategy.cancel(id='long limit exit')
        strategy.entry(id='long limit', direction=strategy.long, stop = limitIntrabarBreakoutPriceLong, limit = limitIntrabarBreakoutPriceLong + stdev_average, comment = "limit long")
        strategy.exit(id='initial long limit exit', from_entry='long limit', stop = limitIntrabarBreakoutPriceLong - (stdev_average * 2), comment="initial long limit exit") 



