                        //    intrabarBrLoCoShortRemoval := intrabarBrLoCoShortRemoval + 2758

                    intrabarBreakoutShortConditions := intrabarBreakoutShortConditions == true ? true : false

                    // Volume Check
                    // --------------- 
                    
                    if (useVolumeCondForShortEntry == false or (vol_condition and useVolumeCondForShortEntry == true))


                        // Check if actual method is sending in this candel
                        // ---------------
                        
                        if (array_includes(shortSignals, shortMethod))
                        
                            // Verhalten bei wiederkehrenden Signalen
                            // ---------------

                            //if (useAdjustStopLossOnRecurringSignalsShort == true or (useAdjustStopLossOnRecurringSignalsShort == false and (strategy.position_size == 0.0 or strategy.position_size > 0 or (strategy.position_size < 0 and tradeType != "short")))) 
                        
                            if (useShort)
                                shortEntry := true
                                //stopLossPriceShort := close * stopLossMultShort
                                stopLossPriceShort := close + (stdev_average * stopLossStdevMultShort)
                                tradeMethodShort := shortMethod
                                tradeType := "short"
                            else
                                shortEntrySignalDespiteDeactivated := true

                else
                    intrabarBreakoutShortConditions := false
                    intrabarBrLoCoShortRemoval := intrabarBrLoCoShortRemoval + 3453

                //else
                //    intrabarBreakoutShortConditions := false
                //    intrabarBrLoCoShortRemoval := intrabarBrLoCoShortRemoval + 2794
            else
                intrabarBreakoutShortConditions := false
                intrabarBrLoCoShortRemoval := intrabarBrLoCoShortRemoval + 2797
        else
            intrabarBreakoutShortConditions := false
            intrabarBrLoCoShortRemoval := intrabarBrLoCoShortRemoval + 2799

                        
    
    // Long, cooldown of 5
    // ---------------

    atrNeq1to3 = returnOccuranceOfConditionBool("bool", atrRangeCond, "!=", 1, 3)

    if useLong 
        
        // smmaTrend Check
        // ---------------
        
        if ( useSMMATrendLong == false or ( useSMMATrendLong == true and smmaTrendUpOccurance2 > 1 ) ) // repair 11. mai 2023 and returnOccuranceOfConditionString("string", slowSmmaTrend, "==", "up", 2) > 1 ) )
            
