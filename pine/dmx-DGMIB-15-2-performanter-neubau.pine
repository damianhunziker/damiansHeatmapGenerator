len240 = 56
len480 = 112

varip plus = float(na)
varip minus = float(na)
varip ta = float(na)

up = ta.change(high,1)
down = -ta.change(low,1)
plusDM = (na(up) ? na : (up > down and up > 0 ? up : 0))
minusDM = (na(down) ? na : (down > up and down > 0 ? down : 0))
ta := (math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1])))

trur240 = ta.rma(ta, len240)
DIP240 = (100 * ta.rma(up, len240) / trur240)
DIN240 = (100 * ta.rma(down, len240) / trur240)

trur480 = ta.rma(ta, len480)
DIPlusIntval = (100 * ta.rma(up, len480) / trur480)
DIMinusIntval = (100 * ta.rma(down, len480) / trur480)

DIPlus = DIPlusIntval
DIMinus = DIMinusIntval

