    // ---------------
    
    //if (useSMMATrendShort == false or (useSMMATrendShort == true and smmaTrend == "down" and smmaTrend[1] == "down" and smmaTrend[2] == "down" and smmaTrend[3] == "down" and smmaTrend[4] == "down" and smmaTrend[5] == "down"))
    
    if (useShort)    

        if ( ( smmaSlowTrendDownOccurance2 > 1 and smmaTrendDownOccurance2  > 1 ) or not useSMMATrendShort )
        
            // ADX, AtrRange Check
            // ---------------    
            
            if (useAdx == false or (adx_trend == "verkaufen" and useAdx == true)) and (not useAtrRangeCondShort or (not atrRangeCond and not atrRangeCond2_mtf and not atrRangeCond3_mtf and not atrRangeCond4_mtf and not atrRangeCond5_mtf))
            
                // Pair Switcher
                if ( not usePairSwitcher or isWorstPerformer ) and ( not useAfterSqueezeZoneShort or afterSqueezeZone )

                    // Divergence Check
                    // --------------- 
                    
                    //if (useDivergenceCheckShort == false or (useDivergenceCheckShort == true and (returnOccuranceOfConditionBool("bool", buyDivergenceIntactShortEntry, "==", 1, periodForDivergenceCheckShort) < 1) or sellDivergenceIntactShortEntry))
                    //if (useDivergenceCheckShort == false or (useDivergenceCheckShort == true and buyDivergenceIntactShortEntry == false and buyDivergenceIntactShortExit == false))

