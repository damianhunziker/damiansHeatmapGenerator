atrRangeMa   = MaTypes(atrRangeHmaModeSwitch, atrRangeAtr, atrRangeHmaLength)
atrRangeAtr := atrRangeAtr * atrRangeScalingFactor
atrRangeCond = atrRangeMa > atrRangeAtr

