            longEntry := true
            stopLossPriceLong := resulting_close * 0.97
            tradeMethodLong := "div confirmed"
            tradeType := "long3"
            
        if tradeMethodLong == "div confirmed" and tradeType == "long3" and array_includes(longCloseSignals, "div confirmed")
            longCloseReason := "div confirmed"
            longClose := true
        
    // ultra-divs
