    //else
    
    resultingTakeProfitStartPercLong := takeProfitStartPercLong
    resultingTrailPercLong := trailPercLong
               
    // Intercept entry signals if the actual trade is understroyable
              
//    if longEntry and undestroyableTradeLong[1]
//        longEntry := false
//        stopLossPriceLong := stopLossPriceLong[1]
