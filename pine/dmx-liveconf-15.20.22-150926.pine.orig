    array.push(fibo_ratios, 0.236)
    array.push(fibo_ratios, 0.382)
    array.push(fibo_ratios, 0.618)
    array.push(fibo_ratios, 0.786)

get_channel(src_lr, len_lr) =>
    mid = math.sum(src_lr, len_lr) / len_lr
    slope = ta.linreg(src_lr, len_lr, 0) - ta.linreg(src_lr, len_lr, 1)
    intercept = mid - slope * math.floor(len_lr / 2) + (1 - len_lr % 2) / 2 * slope
    endy = intercept + slope * (len_lr - 1)
    dev = 0.0
    for x = 0 to len_lr - 1 by 1
        dev += math.pow(src_lr[x] - (slope * (len_lr - x) + intercept), 2)
        dev
    dev := math.sqrt(dev / len_lr)
    [intercept, endy, dev, slope]

[y1_, y2_, dev, slope] = get_channel(src_lr, len_lr)

upper_linreg = y2_ + 2 * dev
lower_linreg = y2_ - 2 * dev

plot(not showOnlyDemoItems ? upper_linreg : na, title="upper_linreg", color = color.orange)
plot(not showOnlyDemoItems ? lower_linreg : na, title="lower_linreg", color = color.blue)
 
