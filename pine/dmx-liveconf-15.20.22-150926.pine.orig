// Calculations (Bull & Bear Balance Indicator by Vadim Gimelfarb)
iff_1 = resulting_close[1] < resulting_open ? math.max(resulting_high - resulting_close[1], resulting_close - resulting_low) : math.max(resulting_high - resulting_open, resulting_close - resulting_low)
iff_2 = resulting_close[1] > resulting_open ? resulting_high - resulting_low : math.max(resulting_open - resulting_close[1], resulting_high - resulting_low)
iff_3 = resulting_close[1] < resulting_open ? math.max(resulting_high - resulting_close[1], resulting_close - resulting_low) : resulting_high - resulting_open
iff_4 = resulting_close[1] > resulting_open ? resulting_high - resulting_low : math.max(resulting_open - resulting_close[1], resulting_high - resulting_low)
iff_5 = resulting_close[1] < resulting_open ? math.max(resulting_open - resulting_close[1], resulting_high - resulting_low) : resulting_high - resulting_low
iff_6 = resulting_close[1] > resulting_open ? math.max(resulting_high - resulting_open, resulting_close - resulting_low) : iff_5
iff_7 = resulting_high - resulting_close < resulting_close - resulting_low ? iff_4 : iff_6
iff_8 = resulting_high - resulting_close > resulting_close - resulting_low ? iff_3 : iff_7
iff_9 = resulting_close > resulting_open ? iff_2 : iff_8
bullPower = resulting_close < resulting_open ? iff_1 : iff_9
iff_10 = resulting_close[1] > resulting_open ? math.max(resulting_close[1] - resulting_open, resulting_high - resulting_low) : resulting_high - resulting_low
iff_11 = resulting_close[1] > resulting_open ? math.max(resulting_close[1] - resulting_low, resulting_high - resulting_close) : math.max(resulting_open - resulting_low, resulting_high - resulting_close)
iff_12 = resulting_close[1] > resulting_open ? math.max(resulting_close[1] - resulting_open, resulting_high - resulting_low) : resulting_high - resulting_low
iff_13 = resulting_close[1] > resulting_open ? math.max(resulting_close[1] - resulting_low, resulting_high - resulting_close) : resulting_open - resulting_low
iff_14 = resulting_close[1] < resulting_open ? math.max(resulting_open - resulting_low, resulting_high - resulting_close) : resulting_high - resulting_low
iff_15 = resulting_close[1] > resulting_open ? math.max(resulting_close[1] - resulting_open, resulting_high - resulting_low) : iff_14
iff_16 = resulting_high - resulting_close < resulting_close - resulting_low ? iff_13 : iff_15
iff_17 = resulting_high - resulting_close > resulting_close - resulting_low ? iff_12 : iff_16
iff_18 = resulting_close > resulting_open ? iff_11 : iff_17
bearPower = resulting_close < resulting_open ? iff_10 : iff_18

// Calculations (Bull & Bear Pressure Volume)
bullVolume = bullPower / (bullPower + bearPower) * resulting_volume
bearVolume = bearPower / (bullPower + bearPower) * resulting_volume

// Calculations Delta
delta = bullVolume - bearVolume
cvd = ta.cum(delta)
cvdMa = ta.sma(cvd, periodMa)

