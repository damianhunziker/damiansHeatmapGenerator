//        tradeMethodShort := na

    // --------------------
    // Execution of the trades
    // -------------------- 
    
    // Long
    // ----
                
    if (longEntry)

        if (tradeMethodLong[1] != "none")
        
            // logic for what happens on repeated signals from already in action trades   
            if (tradeMethodLong[1] == tradeMethodLong and tradeType[1] == tradeType)
                
                // repeated signal
                if tradeType == "long"
                    
                    //if bevaviorAtRepetionLong == "Recalculate"
                        //stopLossPriceLong := close * stopLossMultLong
                        
                    if bevaviorAtRepetionLong == "Recalculate Higher Only"
                        //stopLossPriceLongNew = close * stopLossMultLong
                        stopLossPriceLong := math.max(stopLossPriceLong[1], stopLossPriceLong)
                        
                    if bevaviorAtRepetionLong == "no action"
                        // reset it to initial value
                        stopLossPriceLong := initialStopLossPriceLong
                        
                else if tradeType == "sidewaysLong"
                
                    //if bevaviorAtRepetionSidewaysLong == "Recalculate"
                    //    stopLossPriceLong := close * stopLossMultSidewaysLong
                        
                    if bevaviorAtRepetionSidewaysLong == "Recalculate Higher Only"
                        //stopLossPriceLong := close * stopLossMultSidewaysLong
                        stopLossPriceLong := math.max(stopLossPriceLong, stopLossPriceLong[1])
                        
                    if bevaviorAtRepetionSidewaysLong == "no action"
                        // reset it to initial value
                        stopLossPriceLong := initialStopLossPriceLong
                        
            else
                
                // TradeType nur neu schreiben wenn Trade auch wirklich ausgeführt wird, ansonsten reset zu werten davor
                tradeType := tradeType[1]
                stopLossPriceLong := initialStopLossPriceLong
                tradeMethodLong := tradeMethodLong[1]
                
            //else
            //    stopLossPriceLong := math.max(stopLossPriceLong, stopLossPriceLong[1])
           
        else
        
            resultingTradeMethod = ""
            if (tradeMethodLong == "nls2")
                if (array_includes(longSignals, "broad1"))
                    resultingTradeMethod := "broad1"
                    tradeMethodLongTightOrBroad := "broad1"
                if (array_includes(longSignals, "broad2"))
                    resultingTradeMethod := "broad2"
                    tradeMethodLongTightOrBroad := "broad2"
                if (array_includes(longSignals, "broad3"))
                    resultingTradeMethod := "broad3"
                    tradeMethodLongTightOrBroad := "broad3"
                if (array_includes(longSignals, "tight"))
                    resultingTradeMethod := "tight"
                    tradeMethodLongTightOrBroad := "tight"
            else
                resultingTradeMethod := tradeMethodLong
                    
            // initial signal
            if not entryPriceLong
                entryPriceLong := resulting_close
            strategy.entry("long",strategy.long, comment = resultingTradeMethod + " " + tradeType)
            //stopLossPriceLong := close * stopLossMultLong
            stopLossPriceLong := math.max(stopLossPriceLong, stopLossPriceLong[1])
            executingTradeLong := true
        
    if (longClose)    
        strategy.close("long", comment = longCloseReason + " " + tradeType + " close")
        earningsAfterCloseTrade := resulting_close - entryPriceLong
        executingClose := true
        executingClose

    // Long Stop Loss / Take Profit Procession
    // ----
    
    if tradeType[1] == "sidewaysLong"
        resultingTakeProfitStartPercLong := takeProfitStartPercSidewaysLong
        resultingTrailPercLong := trailPercSidewaysLong
            
    if tradeType[1] == "long3"
        resultingTakeProfitStartPercLong := 10000000000
        resultingTrailPercLong := 10000000000
            
    // Determine trail stop loss prices
    takeProfitPriceLong := if strategy.position_size > 0 and (resulting_close > entryPriceLong * (1 + resultingTakeProfitStartPercLong) or entryPriceReached)
        entryPriceReached := true
        math.max(resulting_close * (1 - resultingTrailPercLong), takeProfitPriceLong[1])
    else
        0

    profit = 0.0
    profitPerc = 0.0

    if (entryPriceLong)
        profit := close - entryPriceLong
        profitPerc := 100 / (entryPriceLong / profit)

    if (entryPriceShort)
        profit := entryPriceShort - close
        profitPerc := 100 / (entryPriceShort / profit)

    

    if strategy.position_size > 0 or strategy.position_size < 0

        tradeBGColor:= color.new(color.blue, 70)

    prot2Text = str.tostring(math.round(profitPerc,2)) + " %"


    lastLiveProfitLabel= label.new(bar_index, high, text ="", style = label.style_none)
    if strategy.position_size > 0 or strategy.position_size < 0
        lastLiveProfitLabel := label.new(bar_index-3, high + (high * 0.03), text = prot2Text, textcolor = profitPerc >= 0 ? color.green : color.red, size = size.huge, style = label.style_none, text_font_family = font.family_monospace)
        label.delete(lastLiveProfitLabel[1])
    else
        lastLiveProfitLabel := label.new(bar_index, high, text ="", style = label.style_none)        
        label.delete(lastLiveProfitLabel[1])


    if not strategy.position_size and not executingTradeLong
        tradeMethodLong := "none"
        tradeMethodLongTightOrBroad := "none"
        takeProfitPriceLong := 0.0
        profitLevelReachedLong := 0.0
        stopLossPriceLong := 0.0
        entryPriceLong := 0.0
        entryPriceReached := false
        tradeAgeLong := 0
        resultingStopPriceLong := 0.0
        undestroyableTradeLong := false
        tradeEntryIsCustomLong := false

        percByStrategy = math.round(strategy.closedtrades.profit_percent(strategy.closedtrades-1), 2)
        protText = str.tostring(percByStrategy) + " %"

        if strategy.position_size[1] > 0
            label.new(bar_index, high + (high * 0.03), text = protText, textcolor = percByStrategy >= 0 ? color.green : color.red, size = size.huge, style = label.style_none, text_font_family = font.family_monospace)
//
        if strategy.position_size[1] < 0
            label.new(bar_index, high + (high * 0.03), text = protText, textcolor = percByStrategy >= 0 ? color.green : color.red, size = size.huge, style = label.style_none, text_font_family = font.family_monospace)

    
    if strategy.position_size or longEntry
        tradeAgeLong += 1
        
        if not longEntry and (tradeType == "long" or tradeType == "sidewaysLong")
                    
            if bevaviorAtRepetionLong == "Recalculate Higher Only"
                stopLossPriceLong := math.max(stopLossPriceLong[1], stopLossPriceLong)
                
            else if bevaviorAtRepetionLong == "no action"
                // reset it to initial value
                stopLossPriceLong := initialStopLossPriceLong
                    
//        if longEntry != true and ((tradeType == "long" and (longMethod == "SAR" or longCloseMethod == "SAR")) or (tradeType == "sidewaysLong" and (sidewaysLongMethod == "SAR" or sidewaysLongCloseMethod == "SAR")))  
//            stopLossPriceLong := SAR
            
        // Set long Take Profit and Stop Loss
        if (useStopLossLong or useTakeProfitLong) and (stopLossPriceLong > 0 or takeProfitPriceLong > 0)
            if takeProfitPriceLong > stopLossPriceLong
                resultingStopPriceLong := takeProfitPriceLong
            else
                resultingStopPriceLong := stopLossPriceLong
        
        // if short entry is true exit long immediately
        if (shortEntry or shortEntrySignalDespiteDeactivated) and useShortEntryAsCloseSignalLong
            strategy.close('long', comment='short entry')

        strategy.exit('tp/sl exit', 'long', stop=resultingStopPriceLong)

    // Short
    // -----

    if shortEntry
    
        //if tradeType[1] == "sidewaysShort" and tradeType == "sidewaysShort" and tradeMethodShort[1] == tradeMethodShort
        
        //if tradeType[1] == "short" and tradeType == "short" and tradeMethodShort[1] == tradeMethodShort
        
        
        if (tradeMethodShort[1] != "none")
        
            // logic for what happens on repeated signals from already in action trades  
            if (tradeMethodShort[1] == tradeMethodShort and tradeType[1] == tradeType)
        
                // repeated signal
                if tradeType == "short"
                
                    //if bevaviorAtRepetionShort == "Recalculate"
                    //    stopLossPriceShort := close * stopLossMultShort
                        
                    if bevaviorAtRepetionShort == "Recalculate Higher Only"
                        //stopLossPriceShort := close * stopLossMultShort
                        stopLossPriceShort := math.min(stopLossPriceShort, stopLossPriceShort[1])
                        
                    if bevaviorAtRepetionShort == "no action"
                        // reset it to last value
                        stopLossPriceShort := initialStopLossPriceShort
                        
                else if tradeType == "sidewaysShort"
                
                    //if bevaviorAtRepetionSidewaysShort == "Recalculate"
                    //    stopLossPriceShort := close * stopLossMultSidewaysShort
                        
                    if bevaviorAtRepetionSidewaysShort == "Recalculate Higher Only"
                        //stopLossPriceShort := close * stopLossMultSidewaysShort
                        stopLossPriceShort := math.min(stopLossPriceShort, stopLossPriceShort[1])
                        
                    if bevaviorAtRepetionSidewaysShort == "no action"
                        // reset it to last value
                        stopLossPriceShort := initialStopLossPriceShort
                //else
                //    stopLossPriceLong := math.max(stopLossPriceLong, stopLossPriceLong[1])
            else
                
                // TradeType nur neu schreiben wenn Trade auch wirklich ausgeführt wird, ansonsten reset zu werten davor
                tradeType := tradeType[1]
                stopLossPriceShort := initialStopLossPriceShort
                tradeMethodShort := tradeMethodShort[1]
            
        else
        
            
            // Erstes Vorkommen von involvierter Divergenz
            if (shortMethod == "div rebound")
                tradeSellDivsLowestPriceShort := array.get(divArrShort, lastSellDivergenceTargetPriceArrayIndex)
                stopLossPriceShort := resulting_high[1] * stopLossMultShort
                //customTrailStartPercShort := 100 / (close / (close - lastSellDivergenceTargetPrice))
                
            //customStopLossPriceShort := open[1]
            
            resultingTradeMethodShort = ""
            if (tradeMethodShort == "nls2 long mirror")
                if (array_includes(shortSignals, "broad1"))
                    resultingTradeMethodShort := "broad1"
                if (array_includes(shortSignals, "tight"))
                    resultingTradeMethodShort := "tight"
            else
                resultingTradeMethodShort := tradeMethodShort
    
            // initial signal
            strategy.entry('short', strategy.short, comment = resultingTradeMethodShort + " " + tradeType)
            if not entryPriceShort
                entryPriceShort := resulting_close
                entryPriceShort
            short_window := false
            //stopLossPriceShort := hh20
            //stopLossPriceShort := close * stopLossMultShort
            //if stopLossPriceShort[1] > 0
            //    stopLossPriceShort := math.min(stopLossPriceShort, stopLossPriceShort[1])
            //    stopLossPriceShort
            executingTradeShort := true
            executingTradeShort

    if shortClose
        strategy.close('short', comment= shortCloseReason + " " + tradeType + " close")
        executingClose := true
        earningsAfterCloseTrade := entryPriceShort - resulting_close
        earningsAfterCloseTrade

    //if (close < (entryPriceShort * 0.9))
    //    stopLossPriceShort := hh10

    //if (close < (entryPriceShort * 0.85))
    //    stopLossPriceShort := hh5

    

    // Short Stop Loss / Take Profit Procession
    // ----
    
    resultingTrailStartPercShort = float(na)
    resultingTrailPercShort = float(na)
    
    resultingTrailStartPercShort := trailStartPercShort
    resultingTrailPercShort := trailPercShort
    
    if tradeType == "sidewaysShort"
        resultingTrailStartPercShort := trailStartPercSidewaysShort
        resultingTrailPercShort := trailPercSidewaysShort
            
    if (customTrailStartPercShort)
        resultingTrailStartPercShort := customTrailStartPercShort
        resultingTrailPercShort := customTrailPercShort
    
    // Determine trail stop loss prices
    stopValue = 0.0
    takeProfitPriceShort := if strategy.position_size < 0 and (resulting_close < entryPriceShort * ((100 - resultingTrailStartPercShort) / 100) or takeProfitPriceShort)
        stopValue := resulting_close * ((100 + resultingTrailPercShort) / 100)
        if takeProfitPriceShort[1] > 0
            math.min(stopValue, takeProfitPriceShort[1])
        else
            stopValue
    else
        0.0

    if strategy.position_size >= 0.00 and not executingTradeShort
        takeProfitPriceShort := 0.0
        tradeMethodShort := "none"
        profitLevelReachedShort := 0.0
        stopLossPriceShort := 0.0
        entryPriceShort := 0.0
        tradeAgeShort := 0
        undestroyableTradeShort := false
        tradeEntryIsCustomShort := false
        tradeSellDivsLowestPriceShort := na
        resultingLimitPrice := na
        tradePutToSARShort := false
        tradeAgeShort

    if strategy.position_size < 0 or shortEntry
        tradeAgeShort += 1
        
        // if short entry is true exit long immediately
        if useLongEntryAsCloseSignalShort == true and (longEntry or array_includes(longSignals, longMethod))
            strategy.close('short', comment='long entry')
        
        if not shortEntry and (tradeType == "short" or tradeType == "sidewaysShort")
                    
            if bevaviorAtRepetionLong == "Recalculate Higher Only"
                stopLossPriceShort := math.min(stopLossPriceShort[1], stopLossPriceShort)
                
            else if bevaviorAtRepetionLong == "no action"
                // reset it to initial value
                stopLossPriceShort := initialStopLossPriceShort
        
        // limit (series int/float) Optionaler Parameter. Profit Target (erfordert einen bestimmten Preis). Wenn es angegeben ist, wird eine Limit Order platziert, um aus der Position zum angegebenen
        // ist ein (oder besserem) Kurs auszusteigen. Priorität des Parameters 'limit' ist höher als die Priorität des Parameters 'profit' ('limit' wird anstelle von 'profit' benutzt, wenn der Wert 
        // nicht 'NaN' ist). Der Standardwert ist "NaN".
        
        if (tradeMethodShort == "div rebound")
            // nimm nur 90% der Differenz zum letzten Div Tiefpunkt
            //if (sellDivergenceConfirmed == false)
            resultingLimitPrice := resulting_close - ((resulting_close - tradeSellDivsLowestPriceShort) * 0.8)
        
        resultingStopPriceShort := stopLossPriceShort

        // Set long Take Profit and Stop Loss
        if (useStopLossShort or useTakeProfitShort) and (stopLossPriceShort > 0 or takeProfitPriceShort > 0)
            if takeProfitPriceShort > stopLossPriceShort
                resultingStopPriceShort := takeProfitPriceShort
            else
                resultingStopPriceShort := stopLossPriceShort
