// from changes_configuration 10.3.22 original nls2, stabiles short v10
strategy(title='Damian Murphy ADX RSI DMAC', shorttitle='DMADX', overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=95, initial_capital=10000, commission_value=0.04, max_bars_back=1000, max_lines_count=400, max_labels_count=400 )
 
// Funktionen
//--------------- 

use_remote_date = false

remote_ticker = input.symbol("", "Symbol")

var resulting_close = 0.0
var resulting_open = 0.0
var resulting_high = 0.0 
var resulting_low = 0.0
var resulting_volume = 0.0 

remote_close = request.security(remote_ticker, "60", close)
remote_open = request.security(remote_ticker, "60", open)
remote_high = request.security(remote_ticker, "60", high)
remote_low = request.security(remote_ticker, "60", low)
remote_volume = request.security(remote_ticker, "60", volume)

if remote_ticker != "" and use_remote_date
    resulting_close := remote_close
    resulting_open := remote_open
    resulting_high := remote_high
    resulting_low := remote_low
    resulting_volume := remote_volume
else
    resulting_close := close
    resulting_open := open
    resulting_high := high
    resulting_low := low
    resulting_volume := volume
   
//plot(resulting_open, title="resulting_open") 
//plot(resulting_high, title="resulting_high")
//plot(resulting_low, title="resulting_low")
//plot(resulting_close, title="resulting_close")
//plot(resulting_volume, title="resulting_volume")

getSmmaTrend(srcSMA, lenSMA, maMethod, ama, colorDown, colorUp) =>

    smma = 0.0
    smmaTrendColor = color.black
    smmaTrend = 'no_trend'

    if (maMethod == "smma")
        smma := na(smma[1]) ? ta.ema(srcSMA, lenSMA) : (smma[1] * (lenSMA - 1) + srcSMA) / lenSMA
    else if (maMethod == "sma")
        smma := ta.sma(srcSMA, lenSMA)
    else if (maMethod == "ema")
        smma := ta.ema(srcSMA, lenSMA)
    else if (maMethod == "vwma")
        smma := ta.vwma(srcSMA, lenSMA)
    else if (maMethod == "ama")    
        smma := ama
    
    smmaDifference = smma[1] - smma
    
    if smmaDifference > 0
        smmaTrend := 'down'
        smmaTrendColor := colorDown
        smmaTrendColor
    else
        smmaTrend := 'up'
        smmaTrendColor := colorUp
        smmaTrendColor
        
    [smma, smmaTrend, smmaTrendColor]

dirmov(len) => 
	up = ta.change(resulting_high)
	down = -ta.change(resulting_low)
	plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
	minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
	truerange = ta.rma(ta.tr, len)
	plus = fixnan(100 * ta.rma(plusDM, len) / truerange)
	minus = fixnan(100 * ta.rma(minusDM, len) / truerange)
	[plus, minus]
adx(dilen, adxlen) =>
	[plus, minus] = dirmov(dilen)
	sum = plus + minus
	adx = 100 * ta.rma(math.abs(plus - minus) / (sum == 0 ? 1 : sum), adxlen)

array_includes(array, needle) => 
    array.includes(array, needle) 

returnOccuranceOfCondition(comparisonValueType, historicalValue, operator, comparisonValue, lookback) =>
    int countOccurances = 0
    for i = 1 to lookback
        //if (comparisonValueType == "bool" or comparisonValueType == "string")  
        //    if operator == "==" and historicalValue[i] == comparisonValue
        //        countOccurances += 1
        //    if operator == "!=" and historicalValue[i] != comparisonValue
        //        countOccurances += 1
                
        if (comparisonValueType == "int" or comparisonValueType == "float") 
            if operator == ">" and historicalValue[i] > comparisonValue[i]
                countOccurances += 1
            if operator == "<" and historicalValue[i] < comparisonValue[i]
                countOccurances += 1
            if operator == "<=" and historicalValue[i] <= comparisonValue[i]
                countOccurances += 1
            if operator == ">=" and historicalValue[i] >= comparisonValue[i]
                countOccurances += 1
            if operator == "==" and historicalValue[i] == comparisonValue[i]
                countOccurances += 1
            if operator == "!=" and historicalValue[i] != comparisonValue[i]
                countOccurances += 1
    countOccurances 
    
returnDistanceToConditionInt(historicalValue, operator, comparisonValue, lookback) =>
    distance = 0
    for i = 1 to lookback
        distance = i
        
        if operator == ">" and historicalValue[i] > comparisonValue[i]
            break
        if operator == "<" and historicalValue[i] < comparisonValue[i]
            break
        if operator == "<=" and historicalValue[i] <= comparisonValue[i]
            break
        if operator == ">=" and historicalValue[i] >= comparisonValue[i]
            break
        if operator == "==" and historicalValue[i] == comparisonValue[i]
            break
        if operator == "!=" and historicalValue[i] != comparisonValue[i]
            break
                
    distance 
    
returnDistanceToConditionBool(historicalValue, operator, comparisonValue, lookback) =>
    distance = 0
    for i = 1 to lookback
        distance := i
        
        if operator == "==" and historicalValue[i] == comparisonValue
            break
        if operator == "!=" and historicalValue[i] != comparisonValue
            break
                
    distance 

returnOccuranceOfConditionBool(comparisonValueType, historicalValue, operator, comparisonValue, lookback) =>
    int countOccurances = 0
    for i = 1 to lookback
        if operator == "==" and historicalValue[i] == comparisonValue
            countOccurances += 1
        if operator == "!=" and historicalValue[i] != comparisonValue
            countOccurances += 1
    countOccurances

returnOccuranceOfConditionString(comparisonValueType, historicalValue, operator, comparisonValue, lookback) =>
    int countOccurances = 0
    for i = 1 to lookback
        if operator == "==" and historicalValue[i] == comparisonValue
            countOccurances += 1
        if operator == "!=" and historicalValue[i] != comparisonValue
            countOccurances += 1
    countOccurances
    
confirmedBBBreakout(direction, band) =>
    confirmed = false
    if direction == "bot" and resulting_close[1] < band[1] and resulting_close < band 
        confirmed := true
    if direction == "top" and resulting_close[1] > band[1] and resulting_close > band
        confirmed := true
    confirmed
   
// adx functions 
getAdxTrend(ADX, DIPlusInt, DIMinusInt) => 
    adx_trend_direction = "neutral"
    adx_trend_valid = false
    adx_rising = false
    adx_rising_color = color.black
    adx_trend = "neutral"
    adx_color = color.black
    
    if (ta.crossover(ADX, 20))
        adx_trend_valid := true
        
    if (ADX < 20)
        adx_trend_valid := false
    
    if (ta.crossunder(ADX, 40))
        adx_trend_valid := false
        
    if (ADX > 40)
        adx_trend_valid := true
        
    if (DIPlusInt > DIMinusInt)
        adx_trend_direction := "long"
    else
        adx_trend_direction := "short"
    
    if (ta.rising(ADX, 1))
        adx_rising := true
        adx_rising_color := color.green
    else
        adx_rising := false
        adx_rising_color := color.white
    
    if (adx_rising)// and ADX < 50)
        if (adx_trend_direction == "long")
            adx_color := color.green
            adx_trend := "kaufen"
        if (adx_trend_direction == "short")
            adx_color := color.red  
            adx_trend := "verkaufen"
    else
        adx_trend := "seitwaerts"
        adx_color := color.yellow
        
    [adx_trend, adx_color]
    
intval = input('600', 'Resolution (1, 5, 60, 240, D, W, M... etc)')
useChartInt = input(false, 'Use Chart Interval Instead?')

diLen = input.int(14, 'DI Length', minval=1)
diSmooth = input.int(1, 'DI Smoothing (Zero-Lag, 1 = off)', minval=1)
adxLen = input.int(14, 'ADX Smoothing (SMA)', minval=1)
thresh = input.int(25, 'ADX Threshold', minval=0)
showHist = input(true, 'DI Histogram')
showSquare = input(false, 'Show Square Wave')
diThresh1 = input.int(10, 'DI+/DI- Threshold 1', minval=0)
diThresh2 = input.int(30, 'DI+/DI- Threshold 2', minval=0)
useHeikin = input(false, 'Heikin-Ashi Mode')
diRangeLen = input.int(21, 'DI Histogram Range Lookback', minval=1)
showDIRange = input(false, 'Show DI Range?')

zeroLag(s, len) =>
    ema1 = ta.ema(s, len)
    ema2 = ta.ema(ema1, len)
    d = 2 * ema1 - ema2
    d

// All calculations for DI+, DI-, ADX will be the live values
// when the chart interval <= desired interval. When the
// desired interval < chart interval, extra data is packed
// into the bars between the desired interval close times.
// The returned plots show the intermediate values while the
// chart interval has not yet reached the end of the desired
// interval close candle.

// The close candle on the desired interval that matches the 
// same time on the chart interval will yield the same plot
// values as if the the chart interval and desired interval
// are the same. For example, set the desired interval to 
// 60, and let the chart interval be 15. The values on the chart
// at 0:45, 1:45, 2:45, 3:45, etc will be the same as if the
// chart interval was switched to 60 while keeping the desired
// interval at 60. However, all values at 0:00, 0:15, 0:30, 1:00,
// 1:15, 1:30, etc. will show intermediate calculations while
// the chart interval is in between successive desired interval
// close times.

getVars(newSession) =>
    hh = resulting_high
    hh := newSession ? resulting_high : math.max(nz(hh[1]), resulting_high)
    ll = resulting_low
    ll := newSession ? resulting_low : math.min(nz(ll[1]), resulting_low)

    oo = nz(ta.valuewhen(newSession, resulting_open, 0))

    pc = nz(ta.valuewhen(newSession, resulting_close[1], 0))
    ph = nz(ta.valuewhen(newSession, hh[1], 0))
    pl = nz(ta.valuewhen(newSession, ll[1], 0))

    xClose = (oo + hh + ll + resulting_close) / 4
    pxc = nz(ta.valuewhen(newSession, nz(xClose[1]), 0))

    pxo = nz(ta.valuewhen(newSession, nz(oo[1]), 0))
    xOpen = (pxo + pxc) / 2

    xHigh = math.max(hh, math.max(xOpen, xClose))
    xLow = math.min(ll, math.min(xOpen, xClose))

    pxh = nz(ta.valuewhen(newSession, nz(xHigh[1]), 0))
    pxl = nz(ta.valuewhen(newSession, nz(xLow[1]), 0))

    v1 = math.abs(xHigh - pxc)
    v2 = math.abs(xLow - pxc)
    v3 = xHigh - xLow

    tr1 = math.max(v1, math.max(v2, v3))

    v11 = math.abs(hh - pc)
    v22 = math.abs(ll - pc)
    v33 = hh - ll

    tr2 = math.max(v11, math.max(v22, v33))

    trueRange = useHeikin ? tr1 : tr2

    hR = useHeikin ? xHigh - pxh : hh - ph
    lR = useHeikin ? pxl - xLow : pl - ll

    dmPos = hR > lR ? math.max(hR, 0) : 0
    dmNeg = lR > hR ? math.max(lR, 0) : 0

    sTR = 0.0
    pstr = nz(ta.valuewhen(newSession, nz(sTR[1]), 0))
    sTR := pstr - pstr / diLen + trueRange

    sDMPos = 0.0
    psdmpos = nz(ta.valuewhen(newSession, nz(sDMPos[1]), 0))
    sDMPos := psdmpos - psdmpos / diLen + dmPos

    sDMNeg = 0.0
    psdmneg = nz(ta.valuewhen(newSession, nz(sDMNeg[1]), 0))
    sDMNeg := psdmneg - psdmneg / diLen + dmNeg

    zeroLag__1 = zeroLag(sDMPos / sTR * 100, diSmooth)
    DIP = diSmooth > 1 ? zeroLag__1 : sDMPos / sTR * 100
    zeroLag__2 = zeroLag(sDMNeg / sTR * 100, diSmooth)
    DIN = diSmooth > 1 ? zeroLag__2 : sDMNeg / sTR * 100
    DX = math.abs(DIP - DIN) / (DIP + DIN) * 100

    // ADX is a sma(DX, adxLen)
    // However since the time frame can be higher we must manually
    // code the successive simple moving average forumula here that
    // can work when the desired interval > chart interval, or when
    // the desired interval = chart interval

    oldDX = nz(ta.valuewhen(newSession, nz(DX[1]), adxLen - 1))
    adx = DX
    padx = nz(ta.valuewhen(newSession, nz(adx[1]), 0))
    adx := padx + (DX - oldDX) / adxLen

    hist = DIP - DIN
    histAbs = math.abs(hist)
    sign = hist >= 0 ? 1 : -1
    sw = histAbs > diThresh2 ? sign * 3 : histAbs > diThresh1 ? sign * 2 : sign

    [DIP, DIN, adx, hist, histAbs, sw]
    
