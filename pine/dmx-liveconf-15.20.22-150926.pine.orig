            stopLossPriceLong := resulting_close * (1 - tightStopLossMultLong)
            
        //stopLossPriceLong := devLong * bbr
        
    if (sidewaysLongMethod == "nls2")
    
        if array_includes(longSignals, "broad2")
            //stopLossPriceLong := close * (1 - broad2StopLossMultLong)
            stopLossPriceLong := resulting_close * (1 - stopLossMultLong)
        else if array_includes(longSignals, "broad1")
            //stopLossPriceLong := close * (1 - broad1StopLossMultLong)
            stopLossPriceLong := resulting_close * (1 - stopLossMultLong)
        else if array_includes(longSignals, "broad3")
            //stopLossPriceLong := close * (1 - broad3StopLossMultLong)
            stopLossPriceLong := resulting_close * (1 - stopLossMultLong)
        //stopLossPriceLong := low[1] * stopLossMultSidewaysLong
        else if (array_includes(longSignals, "tight"))
        //stopLossPriceLong := low_of_last_candle
            stopLossPriceLong := resulting_close * (1 - tightStopLossMultLong)
            
    if (tradeMethodShort == "nls2 long mirror") and (array_includes(shortSignals, "tight"))
        stopLossPriceShort := resulting_close * (1 + tightStopLossMultShort)     
        
        
    
    //if shortEntry            
